                  <description>11 wait states</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0xC</name>
                  <description>12 wait states</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
