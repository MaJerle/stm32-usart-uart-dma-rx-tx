                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>oc4refc is the logical OR of oc2ref and oc5ref</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>GC5C3O</name>
              <description>Group channel 5 and channel 3 (ORed)</description>
