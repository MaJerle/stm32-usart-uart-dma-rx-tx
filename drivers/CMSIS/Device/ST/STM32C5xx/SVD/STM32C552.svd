                  <description>No pull-up is applied on TAMPALRM output</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>A pull-up is applied on TAMPALRM output</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
