                  <description>BOOT0 signal is defined by the BOOT0 option bit.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>BOOT0 signal is defined by BOOT0 pin value (legacy mode).</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BOOT0</name>
              <description>Boot 0 option bit</description>
              <bitOffset>23</bitOffset>
