                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>DAC channel1 is ready to accept the trigger or output data</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
