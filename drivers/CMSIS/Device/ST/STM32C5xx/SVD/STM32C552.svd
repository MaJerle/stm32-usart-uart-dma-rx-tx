            <field>
              <name>RCODE</name>
              <description>Received CCC code (when the I3C is configured as target)</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>RADD</name>
