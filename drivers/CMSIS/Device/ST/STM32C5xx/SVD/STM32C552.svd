                <enumeratedValue>
                  <name>B_0x0</name>
                  <description>Access to registers is always granted.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>B_0x1</name>
                  <description>Access to registers is denied in case of unprivileged access.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FLASH_HDPEXTR</name>
